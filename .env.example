# ---- docker compose ----------------------------------------------------------
# Heslo k databázi PostgreSQL (libovolný silný řetězec)
POSTGRES_PASSWORD=zmente-me
# Tajný klíč pro podepisování přihlašovacích cookies (min. 32 znaků). Vygenerujte: openssl rand -base64 48
AUTH_SECRET=zmente-me-na-dlouhy-nahodny-retezec
# Veřejná adresa aplikace (používá se v odkazech pozvánek)
APP_URL=http://localhost:3000
# Port, na kterém bude aplikace dostupná
APP_PORT=3000
# Tajný klíč pro endpoint /api/cron/fio (pravidelné stahování výpisů). Prázdné = vypnuto.
CRON_SECRET=

# ---- lokální vývoj (bez Dockeru) --------------------------------------------
DATABASE_URL="postgresql://nabidky:zmente-me@localhost:5432/nabidky?schema=public"
