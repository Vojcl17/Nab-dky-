generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  ACCOUNTANT
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitationsCreated Invitation[] @relation("InvitationCreator")
  offers             Offer[]
  invoices           Invoice[]
  payments           Payment[]
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        Role      @default(SALES)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

/// Single-row table with the company (supplier) settings. id is always "default".
model CompanySettings {
  id                    String  @id @default("default")
  name                  String  @default("")
  ico                   String  @default("")
  dic                   String  @default("")
  street                String  @default("")
  city                  String  @default("")
  zip                   String  @default("")
  country               String  @default("CZ")
  email                 String  @default("")
  phone                 String  @default("")
  web                   String  @default("")
  registrationNote      String  @default("")
  bankAccount           String  @default("")
  bankCode              String  @default("")
  iban                  String  @default("")
  bic                   String  @default("")
  vatPayer              Boolean @default(true)
  defaultVatRate        Int     @default(21)
  defaultDueDays        Int     @default(14)
  offerValidityDays     Int     @default(30)
  roundCzkTotals        Boolean @default(false)
  offerNumberFormat     String  @default("N{YYYY}{NNNN}")
  invoiceNumberFormat   String  @default("{YYYY}{NNNN}")
  advanceNumberFormat   String  @default("Z{YYYY}{NNNN}")
  taxDocNumberFormat    String  @default("D{YYYY}{NNNN}")
  creditNoteNumberFormat String @default("O{YYYY}{NNNN}")
  offerFooterNote       String  @default("")
  invoiceFooterNote     String  @default("")
  fioToken              String  @default("")
  fioLastSyncAt         DateTime?
  updatedAt             DateTime @updatedAt
}

enum SequenceKind {
  OFFER
  INVOICE
  ADVANCE
  TAX_DOCUMENT
  CREDIT_NOTE
}

model NumberSequence {
  id   String       @id @default(cuid())
  kind SequenceKind
  year Int
  last Int          @default(0)

  @@unique([kind, year])
}

model Subject {
  id            String    @id @default(cuid())
  name          String
  ico           String    @default("")
  dic           String    @default("")
  street        String    @default("")
  city          String    @default("")
  zip           String    @default("")
  country       String    @default("CZ")
  email         String    @default("")
  phone         String    @default("")
  contactPerson String    @default("")
  note          String    @default("")
  vatPayer      Boolean   @default(false)
  aresUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  offers   Offer[]
  invoices Invoice[]

  @@index([ico])
  @@index([name])
}

model PriceItem {
  id          String   @id @default(cuid())
  code        String   @default("")
  name        String
  description String   @default("")
  unit        String   @default("ks")
  priceCzk    Decimal  @db.Decimal(14, 2)
  priceEur    Decimal? @db.Decimal(14, 2)
  vatRate     Int      @default(21)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerItems   OfferItem[]
  invoiceItems InvoiceItem[]

  @@index([code])
  @@index([name])
}

enum Currency {
  CZK
  EUR
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  INVOICED
}

model Offer {
  id            String       @id @default(cuid())
  number        String       @unique
  status        OfferStatus  @default(DRAFT)
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  issueDate     DateTime     @db.Date
  validUntil    DateTime     @db.Date
  currency      Currency     @default(CZK)
  exchangeRate  Decimal      @default(1) @db.Decimal(12, 4)
  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0) @db.Decimal(14, 2)
  title         String       @default("")
  note          String       @default("")
  internalNote  String       @default("")
  createdById   String?
  createdBy     User?        @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items    OfferItem[]
  invoices Invoice[]

  @@index([status])
  @@index([subjectId])
}

model OfferItem {
  id              String     @id @default(cuid())
  offerId         String
  offer           Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  priceItemId     String?
  priceItem       PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  position        Int
  name            String
  description     String     @default("")
  quantity        Decimal    @db.Decimal(14, 3)
  unit            String     @default("ks")
  unitPrice       Decimal    @db.Decimal(14, 2)
  vatRate         Int        @default(21)
  discountPercent Decimal    @default(0) @db.Decimal(6, 2)
  noDiscount      Boolean    @default(false)

  @@index([offerId])
}

enum InvoiceType {
  INVOICE
  ADVANCE
  TAX_DOCUMENT
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  type           InvoiceType   @default(INVOICE)
  status         InvoiceStatus @default(DRAFT)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id])
  offerId        String?
  offer          Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// For TAX_DOCUMENT: the ADVANCE it belongs to. For CREDIT_NOTE: the corrected invoice.
  /// For a final INVOICE: the ADVANCE that is deducted.
  relatedInvoiceId String?
  relatedInvoice   Invoice?    @relation("RelatedInvoices", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  relatedTo        Invoice[]   @relation("RelatedInvoices")
  variableSymbol String        @default("")
  constantSymbol String        @default("")
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  taxDate        DateTime?     @db.Date
  currency       Currency      @default(CZK)
  exchangeRate   Decimal       @default(1) @db.Decimal(12, 4)
  discountType   DiscountType  @default(NONE)
  discountValue  Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  roundTotal     Boolean       @default(false)
  note           String        @default("")
  internalNote   String        @default("")
  /// Snapshot of the customer at the time of issue.
  customerName   String        @default("")
  customerIco    String        @default("")
  customerDic    String        @default("")
  customerStreet String        @default("")
  customerCity   String        @default("")
  customerZip    String        @default("")
  customerCountry String       @default("CZ")
  customerEmail  String        @default("")
  /// Snapshot of the supplier (company settings) at the time of issue.
  supplier       Json?
  paidAmount     Decimal       @default(0) @db.Decimal(14, 2)
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([type])
  @@index([subjectId])
  @@index([variableSymbol])
}

model InvoiceItem {
  id              String     @id @default(cuid())
  invoiceId       String
  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  priceItemId     String?
  priceItem       PriceItem? @relation(fields: [priceItemId], references: [id], onDelete: SetNull)
  position        Int
  name            String
  description     String     @default("")
  quantity        Decimal    @db.Decimal(14, 3)
  unit            String     @default("ks")
  unitPrice       Decimal    @db.Decimal(14, 2)
  vatRate         Int        @default(21)
  discountPercent Decimal    @default(0) @db.Decimal(6, 2)
  /// Excluded from the document-level discount (e.g. advance deduction lines).
  noDiscount      Boolean    @default(false)

  @@index([invoiceId])
}

model BankTransaction {
  id                String    @id @default(cuid())
  fioId             BigInt    @unique
  date              DateTime  @db.Date
  amount            Decimal   @db.Decimal(14, 2)
  currency          String
  counterAccount    String    @default("")
  counterBankCode   String    @default("")
  counterName       String    @default("")
  variableSymbol    String    @default("")
  constantSymbol    String    @default("")
  specificSymbol    String    @default("")
  message           String    @default("")
  comment           String    @default("")
  type              String    @default("")
  createdAt         DateTime  @default(now())

  payment Payment?

  @@index([variableSymbol])
  @@index([date])
}

model Payment {
  id                String           @id @default(cuid())
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Decimal          @db.Decimal(14, 2)
  currency          Currency
  date              DateTime         @db.Date
  note              String           @default("")
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())

  @@index([invoiceId])
}

model ExchangeRate {
  id       String   @id @default(cuid())
  currency String
  date     DateTime @db.Date
  rate     Decimal  @db.Decimal(12, 4)
  amount   Int      @default(1)

  @@unique([currency, date])
}

model FioSyncLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  ok       Boolean
  message  String   @default("")
  imported Int      @default(0)
  matched  Int      @default(0)
}
